#!/usr/bin/env python3
"""Run a fifteen-minute WatchRelay workload with bounded synthetic downloads."""

import argparse
from datetime import datetime, timezone
import json
from pathlib import Path
import subprocess
import time


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--port", type=int, default=1080)
    args = parser.parse_args()
    if not 1 <= args.port <= 65535:
        parser.error("port must be between 1 and 65535")
    script = Path(__file__).resolve()
    started_at = datetime.now(timezone.utc)
    start = time.monotonic()
    outcomes = []
    interrupted = False
    try:
        for minute in range(15):
            size = 262144 if minute in (4, 9, 14) else 8192
            request = subprocess.run(
                [script.with_name("test-https"), "relay", "--port", str(args.port),
                 "--download-bytes", str(size), "--max-time", "50"],
                check=False,
            )
            outcomes.append({"minute": minute + 1, "bytes_requested": size, "exit_code": request.returncode})
            time.sleep(max(0, start + (minute + 1) * 60 - time.monotonic()))
    except KeyboardInterrupt:
        interrupted = True
    finally:
        folder = script.parents[1] / "evidence" / "endurance"
        folder.mkdir(mode=0o700, parents=True, exist_ok=True)
        report = {
            "started_utc": started_at.isoformat(),
            "elapsed_s": round(time.monotonic() - start, 3),
            "requests": outcomes,
            "completed": not interrupted and len(outcomes) == 15,
        }
        evidence = folder / f"{started_at.strftime('%Y%m%dT%H%M%SZ')}.json"
        evidence.write_text(json.dumps(report, indent=2) + "\n")
        print(evidence)
    return 130 if interrupted else int(any(item["exit_code"] for item in outcomes))


if __name__ == "__main__":
    raise SystemExit(main())
