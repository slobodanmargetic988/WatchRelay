#!/usr/bin/env python3
"""Start and stop the bounded local WatchRelay Darwin tunnel."""

import argparse
import hashlib
import os
from pathlib import Path
import re
import socket
import stat
import subprocess
import sys
import time


HERE = Path(__file__).resolve().parent
STATE = Path("/private/var/run/watchrelay-wide")
ENGINE_SHA = "6546126c1759683fe85798da92409215d53c50e0f2b346b4f74a61babc8dbec2"
PROFILE_SHA = "4ff33ef3a9ab011efa9d0a750aae55f2fe91577821ce5a8dfa4da50062c02a6e"
TUN_IPV4 = "198.18.245.1"

# Run only built-in system tools and the two copies staged in the root-owned
# runtime directory. Both application input paths and the profile are checked
# after copying, so an ordinary user cannot replace an already-staged file.
BOOTSTRAP = r"""
set -euo pipefail
PATH=/usr/bin:/bin:/usr/sbin:/sbin
export PATH LC_ALL=C
umask 077
run=/private/var/run/watchrelay-wide
[[ $EUID == 0 && ${SUDO_UID:-} =~ ^[0-9]+$ && $# == 8 ]]
[[ $7 =~ ^[0-9]+$ && $7 -ge 20 && $7 -le 600 ]]
if ! mkdir -m 755 "$run"; then
    echo 'A WatchRelay tunnel session already exists. Run off first.' >&2
    exit 1
fi

cleanup_files() {
    for entry in sing-box config.json dns-owner control state supervisor.log dns.log; do
        if [[ -e "$run/$entry" ]]; then unlink "$run/$entry"; fi
    done
    rmdir "$run"
}
trap cleanup_files EXIT

# sing-tun may replace an identical existing route. Refuse any such conflict.
if netstat -rn -f inet | awk '$1 ~ /^(0|0\.0\.0\.0|128|128\.0|128\.0\.0|128\.0\.0\.0)\/1$/ { found=1 } END { exit !found }' ||
   netstat -rn -f inet6 | awk '$1 == "::/1" || $1 == "8000::/1" { found=1 } END { exit !found }'; then
    echo 'A split default route already exists. Disconnect other tunnels first.' >&2
    exit 1
fi
if ifconfig -a | awk '$1 == "inet" && $2 == "198.18.245.1" { found=1 } END { exit !found }'; then
    echo 'The WatchRelay tunnel address is already present.' >&2
    exit 1
fi

install -m 700 "$1" "$run/sing-box"
install -m 600 "$2" "$run/config.json"
install -m 700 "$3" "$run/dns-owner"
verify() {
    local actual
    actual=$(shasum -a 256 < "$1")
    [[ ${actual%% *} == "$2" ]]
}
if ! verify "$run/sing-box" "$4" || ! verify "$run/config.json" "$5" || ! verify "$run/dns-owner" "$6"; then
    echo 'A staged component failed its checksum.' >&2
    exit 1
fi
"$run/sing-box" check -c "$run/config.json"
mkfifo -m 600 "$run/control"
chown "$SUDO_UID" "$run/control"
printf 'STARTING\n' > "$run/state"
chmod 644 "$run/state"

nohup /bin/bash -c "$8" watchrelay-worker "$7" </dev/null >"$run/supervisor.log" 2>&1 &
supervisor=$!
trap - EXIT
for ((i=0; i<100; i++)); do
    if grep -q '^ACTIVE ' "$run/state" 2>/dev/null; then exit 0; fi
    if ! kill -0 "$supervisor" 2>/dev/null || [[ ! -d "$run" ]]; then break; fi
    sleep .2
done
echo 'The WatchRelay tunnel did not become ready and is rolling back.' >&2
if [[ -r "$run/supervisor.log" ]]; then cat "$run/supervisor.log" >&2; fi
kill -TERM "$supervisor" 2>/dev/null || true
exit 1
"""

WORKER = r"""
set -euo pipefail
PATH=/usr/bin:/bin:/usr/sbin:/sbin
export PATH LC_ALL=C
umask 077
run=/private/var/run/watchrelay-wide
deadline=$((SECONDS + $1))
engine=
dns=

wait_for_stop() {
    local child="$1" i
    [[ -n "$child" ]] || return 0
    kill -TERM "$child" 2>/dev/null || true
    for ((i=0; i<55; i++)); do
        if ! kill -0 "$child" 2>/dev/null; then break; fi
        sleep .1
    done
    if kill -0 "$child" 2>/dev/null; then kill -KILL "$child" 2>/dev/null || true; fi
    wait "$child" 2>/dev/null || true
}

cleanup() {
    # Remove the temporary resolver before taking away its tunnel route.
    wait_for_stop "$dns"
    wait_for_stop "$engine"
    for entry in sing-box config.json dns-owner control state supervisor.log dns.log; do
        if [[ -e "$run/$entry" ]]; then unlink "$run/$entry"; fi
    done
    rmdir "$run"
}
trap cleanup EXIT
trap 'exit 0' INT TERM
trap '' HUP
exec 3<>"$run/control"

# The guard also terminates its engine child if this supervisor disappears.
/bin/bash -c '
    owner="$1"
    shift
    "$@" &
    child=$!
    finish() {
        kill -TERM "$child" 2>/dev/null || true
        for ((i=0; i<25; i++)); do
            if ! kill -0 "$child" 2>/dev/null; then break; fi
            sleep .1
        done
        if kill -0 "$child" 2>/dev/null; then kill -KILL "$child" 2>/dev/null || true; fi
        wait "$child" 2>/dev/null || true
    }
    trap finish EXIT
    trap "exit 0" INT TERM
    while kill -0 "$owner" 2>/dev/null && kill -0 "$child" 2>/dev/null; do sleep .5; done
' watchrelay-engine "$$" "$run/sing-box" run -c "$run/config.json" &
engine=$!

tun_interface() {
    ifconfig -a | awk '
        /^utun[0-9]+:/ { name=$1; sub(/:$/, "", name); next }
        /^[^ \t]/ { name="" }
        $1=="inet" && $2=="198.18.245.1" && name!="" { print name }
    '
}
route_interface() {
    route -n get "$@" 2>/dev/null | awk '$1 == "interface:" {print $2}'
}

tun=
for ((i=0; i<60 && SECONDS<deadline; i++)); do
    kill -0 "$engine" 2>/dev/null || { echo 'Tunnel engine exited during setup.'; exit 1; }
    tun=$(tun_interface)
    if [[ "$tun" =~ ^utun[0-9]+$ ]] &&
       [[ $(route_interface -inet 1.1.1.1) == "$tun" ]] &&
       [[ $(route_interface -inet 198.18.245.2) == "$tun" ]] &&
       [[ $(route_interface -inet6 2606:4700:4700::1111) == "$tun" ]] &&
       [[ $(route_interface -inet 127.0.0.1) == lo0 ]]; then
        break
    fi
    tun=
    sleep .2
done
[[ -n "$tun" ]] || { echo 'The WatchRelay interface or split routes did not appear.'; exit 1; }

"$run/dns-owner" "$tun" >"$run/dns.log" 2>&1 &
dns=$!
for ((i=0; i<30 && SECONDS<deadline; i++)); do
    kill -0 "$dns" 2>/dev/null || { cat "$run/dns.log"; exit 1; }
    if grep -Fqx "READY $tun 198.18.245.2" "$run/dns.log"; then break; fi
    sleep .2
done
grep -Fqx "READY $tun 198.18.245.2" "$run/dns.log" || { cat "$run/dns.log"; exit 1; }
printf 'ACTIVE %s trial %s\n' "$tun" "$$" >"$run/state"

while kill -0 "$engine" 2>/dev/null && kill -0 "$dns" 2>/dev/null; do
    if [[ $deadline != 0 && $SECONDS -ge $deadline ]]; then break; fi
    if IFS= read -r -t 1 -u 3 command; then
        case "$command" in
            stop) break ;;
            keep)
                deadline=0
                printf 'ACTIVE %s kept %s\n' "$tun" "$$" >"$run/state"
                ;;
        esac
    fi
done
"""


def digest(path):
    result = hashlib.sha256()
    with path.open("rb") as source:
        for chunk in iter(lambda: source.read(1024 * 1024), b""):
            result.update(chunk)
    return result.hexdigest()


def session_state():
    try:
        root = STATE.lstat()
    except FileNotFoundError:
        return None
    if root.st_uid != 0 or not stat.S_ISDIR(root.st_mode) or root.st_mode & 0o022:
        raise RuntimeError("WatchRelay's runtime directory is unexpected.")
    try:
        state = (STATE / "state").read_text(encoding="ascii").split()
    except FileNotFoundError:
        return ("STARTING",) if STATE.exists() else None
    if not state:
        return ("STARTING",)
    if state == ["STARTING"]:
        return tuple(state)
    if (len(state) != 4 or state[0] != "ACTIVE" or not re.fullmatch(r"utun\d+", state[1])
            or state[2] not in {"trial", "kept"} or not state[3].isdigit()):
        raise RuntimeError("WatchRelay's runtime state is unexpected.")
    return tuple(state)


def active_address(interface):
    result = subprocess.run(["/sbin/ifconfig", interface], capture_output=True, text=True)
    return result.returncode == 0 and re.search(r"\binet " + re.escape(TUN_IPV4) + r"\s", result.stdout)


def print_status():
    state = session_state()
    if state is None:
        print("OFF")
        return 1
    if state[0] == "ACTIVE":
        if not active_address(state[1]):
            print("STARTING")
            return 2
        print(f"ACTIVE {state[1]}")
        return 0
    print("STARTING")
    return 2


def signal_session(command):
    state = session_state()
    if state is None:
        if command == "stop":
            print("OFF")
            return 0
        raise RuntimeError("Start a WatchRelay trial before keeping it active.")
    if command == "keep" and state[0] != "ACTIVE":
        raise RuntimeError("Wait for the WatchRelay tunnel to become active.")
    path = STATE / "control"
    fd = os.open(path, os.O_WRONLY | os.O_NONBLOCK | os.O_NOFOLLOW)
    with os.fdopen(fd, "w", encoding="ascii") as fifo:
        meta = os.fstat(fifo.fileno())
        if not stat.S_ISFIFO(meta.st_mode) or meta.st_uid != os.getuid():
            raise RuntimeError("The WatchRelay control pipe has an unexpected owner or type.")
        fifo.write(command + "\n")
    deadline = time.monotonic() + 15
    while time.monotonic() < deadline:
        current = session_state()
        if command == "stop" and current is None and (len(state) < 2 or not active_address(state[1])):
            print("OFF")
            return 0
        if command == "keep" and current and len(current) > 2 and current[2] == "kept":
            return print_status()
        time.sleep(0.15)
    raise RuntimeError(f"WatchRelay did not confirm {command} before the deadline.")


def start(trial):
    if STATE.exists():
        raise RuntimeError("A WatchRelay tunnel session already exists. Run off first.")
    build = HERE / "build"
    engine, profile, dns = (build / name for name in ("sing-box", "WatchRelay-CLI.json", "dns-owner"))
    if not all(path.is_file() for path in (engine, profile, dns)):
        raise RuntimeError("Run mac/wide/stage cli and mac/wide/build-dns-owner.sh first.")
    if digest(engine) != ENGINE_SHA or digest(profile) != PROFILE_SHA:
        raise RuntimeError("The tunnel engine or profile failed its pinned checksum. Restage both.")
    try:
        with socket.create_connection(("127.0.0.1", 1080), timeout=2) as relay:
            relay.sendall(b"\x05\x01\x00")
            if relay.recv(2, socket.MSG_WAITALL) != b"\x05\x00":
                raise RuntimeError("The local WatchRelay SOCKS listener is not ready.")
    except OSError as exc:
        raise RuntimeError("Start Auto-connect on the watch and its Mac helper first.") from exc
    result = subprocess.run(
        ["/usr/bin/sudo", "--", "/bin/bash", "-c", BOOTSTRAP, "watchrelay-bootstrap",
         str(engine), str(profile), str(dns), ENGINE_SHA, PROFILE_SHA, digest(dns), str(trial), WORKER],
        check=False,
    )
    return result.returncode or print_status()


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    commands = parser.add_subparsers(dest="command", required=True)
    on = commands.add_parser("on", help="start with a local automatic rollback deadline")
    on.add_argument("--trial", type=int, default=90, metavar="SECONDS")
    commands.add_parser("keep", help="keep a healthy trial active until off")
    commands.add_parser("off", help="stop and wait for route and DNS restoration")
    commands.add_parser("status", help="print current session status")
    args = parser.parse_args()
    try:
        if args.command == "status":
            return print_status()
        if args.command in {"keep", "off"}:
            return signal_session("keep" if args.command == "keep" else "stop")
        if not 20 <= args.trial <= 600:
            parser.error("trial must be between 20 and 600 seconds")
        return start(args.trial)
    except (OSError, ValueError, RuntimeError) as exc:
        print(f"WatchRelay: {exc}", file=sys.stderr)
        return 2


if __name__ == "__main__":
    sys.exit(main())
